# ============================================================
# Farmacia El Botiquín · Variables de entorno del backend
# Copia este archivo como `.env` y NUNCA lo subas a Git.
# ============================================================

# Puerto del servidor web / webhooks
PORT=3000

# ---- PROVEEDORES DE IA (se prueban en orden: Gemini -> Groq -> OpenRouter) ----
# Cada proveedor es OPCIONAL: si su API key falta, el gateway lo salta.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Tiempo máximo por llamada a IA (ms) y tope de tokens de salida
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=800

# ---- WHATSAPP ----
# Token temporal que envía Meta en la verificación del webhook (GET /webhook).
# Debe coincidir con el campo "Verify token" del panel de Meta Developers.
WA_VERIFY_TOKEN=verifica-el-botiquin-2026
# Secreto de la app (App Secret): valida que los POST /webhook vengan de Meta.
WA_APP_SECRET=
# Token permanente de la Business API (ej. el que genera 360dialog/Twilio/Meta Cloud API)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# URL base de la API de WhatsApp (Meta Cloud API por defecto)
WA_GRAPH_API_URL=https://graph.facebook.com/v21.0

# ---- PANEL WEB ----
# Contraseña simple para las rutas administrativas del panel (X-Admin-Token).
ADMIN_TOKEN=cambia-este-token
# Origen permitido del panel (CORS). Usa tu dominio real en producción.
CORS_ORIGIN=*

# Persistencia local (JSON en disco). En producción reemplaza por Redis/DB.
DATA_DIR=./data
